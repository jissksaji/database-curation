process {
    cpus = { 1 * task.attempt }
    memory = { 8.GB * task.attempt }
    time = { 2.h * task.attempt }
    errorStrategy = { task.exitStatus in ((130..145) + 104 + 3) ? 'retry' : 'terminate' }
    maxRetries = 3
    maxErrors = '-1'

    withLabel: short_serial {
        cpus = { 1 * task.attempt }
        memory = { 8.GB * task.attempt }
        time = { 2.h * task.attempt }
    }
    withLabel: medium_serial {
        cpus = { 1 * task.attempt }
        memory = { 16.GB * task.attempt }
        time = { 8.h * task.attempt }
    }
    withLabel: long_serial {
        cpus = { 1 * task.attempt }
        memory = { 32.GB * task.attempt }
        time = { 24.h * task.attempt }
    }
    withLabel: short_parallel {
        cpus = { 8 * task.attempt }
        memory = { 24.GB * task.attempt }
        time = { 2.h * task.attempt }
    }
    withLabel: medium_parallel {
        cpus = { 6 * task.attempt }
        memory = { 64.GB * task.attempt }
        time = { 8.h * task.attempt }
    }
    withLabel: long_parallel {
        cpus = { 8 * task.attempt }
        memory = { 96.GB * task.attempt }
        time = { 24.h * task.attempt }
    }
}
