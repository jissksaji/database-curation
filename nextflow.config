params {
    // Input database
    custom_db = null

    // CUSTOM_DB_FILTER module
    custom_db_filter_pattern_exclude = 'synthetic|artificial|construct|recombinant|transgenic|unverified|low[ ._-]?quality|contaminant|chimeric|misidentified|environmental'
    custom_db_include_pattern = 'internal transcribed spacer 2|ITS2'
    custom_db_min_length = 100
    custom_db_max_length = -1
    custom_db_max_consecutive_ns = 2

    // ADD_FLANKING module
    add_flanking_forward = 150
    add_flanking_reverse = 150

    // FUNGAL_SCREENING module
    fungal_screening_db = 'assets/sh_general_release_dynamic_19.02.2025.fasta'
    fungal_screening_search_type = 3
    fungal_screening_min_seq_id = 0.97
    fungal_screening_min_aln_len = 100
    fungal_screening_evalue = 1e-10
    fungal_screening_sensitivity = 7.5
    fungal_screening_max_seqs = 5

    // SCREEN_TAXA module
    screen_taxa_min_sequences = 5

    // VSEARCH_ALLPAIRS_GLOBAL module
    vsearch_allpairs_id = 0.0
    vsearch_allpairs_iddef = 1
    vsearch_allpairs_acceptall = true
    vsearch_allpairs_maxaccepts = 0
    vsearch_allpairs_maxrejects = 0
    vsearch_allpairs_minwordmatches = 0
    vsearch_allpairs_qmask = 'none'

    // ZSCORE_SCREENING module
    zscore_threshold = 2.5
    zscore_min_sequences = 10

    // MMSEQS_EASY_SEARCH module
    mmseqs_easy_search_search_type = 3
    mmseqs_easy_search_min_seq_id = 0.97
    mmseqs_easy_search_min_aln_len = 50
    mmseqs_easy_search_coverage = 0.95
    mmseqs_easy_search_cov_mode = 2
    mmseqs_easy_search_alignment_mode = 3
    mmseqs_easy_search_evalue = 1e-10
    mmseqs_easy_search_sensitivity = 7.5
    mmseqs_easy_search_max_seqs = 20
    mmseqs_easy_search_threads = 10

    // Dereplication module: species or full_length
    dereplication = 'species'

    // ITSX module
    itsx = 'T'

    // Output settings
    outdir = 'results'
    database_version = '0.1.0'
    run_name = null
    publish_dir_mode = 'copy'
    monochrome_logs = false
    multiqc_config = "${projectDir}/conf/multiqc_config.yaml"

    // Installed NCBI taxonomy reference
    reference_base = null
    reference_version = '1.1'

    // Software execution profiles
    conda.enabled = true
    docker.enabled = false
    singularity.enabled = false
    apptainer.enabled = false
    podman.enabled = false
}

manifest {
    name = 'database-curation'
    version = '0.1.0'
    description = 'ITS2 reference database curation workflow'
    nextflowVersion = '24.10.5'
}

process.shell = ['/bin/bash', '-euo', 'pipefail']

timeline {
    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/timeline.html"
}

report {
    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/report.html"
}

trace {
    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/trace.txt"
}

dag {
    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/dag.svg"
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'
includeConfig 'conf/resources.config'

profiles {
    local {
        includeConfig 'conf/local.config'
    }
    conda {
        conda.enabled = true
    }
    docker {
        docker.enabled = true
    }
    singularity {
        singularity.enabled = true
    }
    apptainer {
        apptainer.enabled = true
    }
    podman {
        podman.enabled = true
    }
    pixi {
        process.executor = 'local'
    }
    slurm {
        includeConfig 'conf/slurm.config'
    }
}
